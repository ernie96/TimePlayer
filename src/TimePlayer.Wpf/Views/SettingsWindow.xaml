<Window x:Class="TimePlayer.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TimePlayer.Wpf.Localization"
        xmlns:controls="clr-namespace:TimePlayer.Wpf.Controls"
        Title="{l:T 'Settings'}"
        Width="720" Height="660" MinWidth="540" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#1C1C1F"
        Foreground="#F4F4F5">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingLabel" TargetType="Label">
                <Setter Property="Foreground" Value="#E4E4E7"/>
                <Setter Property="Padding" Value="0,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="250"/>
            </Style>
            <Style x:Key="NoteText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#A1A1AA"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource NoteText}">
            <Run Text="{Binding VersionText, Mode=OneWay}" Foreground="#E4E4E7"/>
            <Run Text="{l:T '. Control+Tab moves between pages. Changes apply right away and are saved when you close this window.'}"/>
        </TextBlock>

        <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                    ItemContainerStyle="{StaticResource StripTabItemStyle}" AutomationProperties.Name="{l:T 'Settings pages'}">

            <!-- ===== Playback ===== -->
            <TabItem Header="{l:T 'Playback'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <CheckBox x:Name="FirstSetting" Content="{l:T 'Continue videos where I left off'}" IsChecked="{Binding ResumePlayback}"/>
                        <CheckBox Content="{l:T 'Autoplay a related video when the queue ends (A in the player)'}" IsChecked="{Binding Autoplay}"/>
                        <CheckBox Content="{l:T 'Use hardware video decoding (takes effect after restart)'}" IsChecked="{Binding EnableHardwareDecoding}"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T 'Preferred video _quality:'}" Target="{Binding ElementName=QualityBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="QualityBox" AutomationProperties.Name="{l:T 'Preferred video quality'}" ItemsSource="{Binding QualityChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SelectedQuality}" MinWidth="180"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T '_Left and Right arrows move:'}" Target="{Binding ElementName=SmallSeekBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="SmallSeekBox" AutomationProperties.Name="{l:T 'Left and Right arrows move'}" ItemsSource="{Binding SmallSeekChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SmallSeekSeconds}" MinWidth="180"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T 'Control+Left and Right m_ove:'}" Target="{Binding ElementName=LargeSeekBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="LargeSeekBox" AutomationProperties.Name="{l:T 'Control+Left and Right move'}" ItemsSource="{Binding LargeSeekChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding LargeSeekSeconds}" MinWidth="180"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T 'Up and Down change the _volume by:'}" Target="{Binding ElementName=VolumeStepBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="VolumeStepBox" AutomationProperties.Name="{l:T 'Up and Down change the volume by'}" ItemsSource="{Binding VolumeStepChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding VolumeStepPercent}" MinWidth="180"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Sound ===== -->
            <TabItem Header="{l:T 'Sound'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource NoteText}"
                                   Text="{l:T 'These effects change TimePlayer\'s sound only; other apps and Windows sound as before. In the player, E and Shift+E switch presets.'}"/>
                        <CheckBox Content="{l:T 'Music mode: no video, and the music sound below (Control+M)'}" IsChecked="{Binding MusicMode}"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T 'Sound for _videos:'}" Target="{Binding ElementName=VideoPresetBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="VideoPresetBox" AutomationProperties.Name="{l:T 'Sound for videos'}" ItemsSource="{Binding AudioPresetChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding VideoSoundPreset}" MinWidth="200"/>
                        </StackPanel>
                        <TextBlock Text="{Binding VideoPresetDescription}" Style="{StaticResource NoteText}"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T 'Sound in _music mode:'}" Target="{Binding ElementName=MusicPresetBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="MusicPresetBox" AutomationProperties.Name="{l:T 'Sound in music mode'}" ItemsSource="{Binding AudioPresetChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding MusicSoundPreset}" MinWidth="200"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MusicPresetDescription}" Style="{StaticResource NoteText}"/>

                        <TextBlock Text="{l:T 'Custom sound'}" Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Style="{StaticResource NoteText}"
                                   Text="{l:T 'Used wherever Custom is chosen above. Changing anything here switches the sound you hear now to Custom. Equalizer sliders go from minus 12 to plus 12 decibels; Left and Right change them by 1, Page Up and Page Down by 3.'}"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{l:T 'Start Custom from the current _preset'}" Command="{Binding CopyPresetToCustomCommand}" Style="{StaticResource SmallButtonStyle}"/>
                            <Button Content="{l:T '_Reset Custom to flat'}" Command="{Binding ResetCustomSoundCommand}" Style="{StaticResource SmallButtonStyle}"/>
                        </WrapPanel>
                        <controls:LayoutItemsControl ItemsSource="{Binding EqualizerBands}" Focusable="False">
                            <controls:LayoutItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="{Binding Label}" Width="250" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                        <Slider Minimum="-12" Maximum="12" SmallChange="1" LargeChange="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Gain}" Width="240" AutomationProperties.Name="{Binding SliderName}"/>
                                        <TextBlock Text="{Binding Gain, StringFormat={}{0:+0;-0;0} dB}" Foreground="#A1A1AA" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </controls:LayoutItemsControl.ItemTemplate>
                        </controls:LayoutItemsControl>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="{l:T 'Bass boost'}" Width="250" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="12" SmallChange="1" LargeChange="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding CustomBass}" Width="240" AutomationProperties.Name="{l:T 'Bass boost, decibels'}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="{l:T 'Clarity'}" Width="250" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="10" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding CustomClarity}" Width="240" AutomationProperties.Name="{l:T 'Clarity, 0 to 10'}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="{l:T 'Stereo width'}" Width="250" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="10" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding CustomWidth}" Width="240" AutomationProperties.Name="{l:T 'Stereo width, 0 to 10'}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T 'R_oom:'}" Target="{Binding ElementName=RoomBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="RoomBox" AutomationProperties.Name="{l:T 'Room'}" ItemsSource="{Binding RoomChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding CustomRoom}" MinWidth="200"/>
                        </StackPanel>
                        <CheckBox Content="{l:T 'Headphone crossfeed (less hard left and right on headphones)'}" IsChecked="{Binding CustomCrossfeed}"/>
                        <CheckBox Content="{l:T 'Even out the volume'}" IsChecked="{Binding CustomLevelVolume}"/>
                        <CheckBox Content="{l:T 'Compressor: quiet sounds louder, loud sounds softer'}" IsChecked="{Binding CustomCompressor}"/>
                        <CheckBox Content="{l:T 'Voice focus: cut low rumble'}" IsChecked="{Binding CustomVoiceFocus}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Speech and braille ===== -->
            <TabItem Header="{l:T 'Speech and braille'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T '_Language (after a restart):'}" Target="{Binding ElementName=LanguageBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="LanguageBox" AutomationProperties.Name="{l:T 'Language (after a restart)'}" ItemsSource="{Binding LanguageChoices}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}" MinWidth="240"/>
                        </StackPanel>
                        <CheckBox Content="{l:T 'Read captions aloud as they appear (C in the player)'}" IsChecked="{Binding SpeakCaptions}"/>
                        <CheckBox Content="{l:T 'Use the NVDA braille add-on (for braille displays; restart NVDA after changing)'}" IsChecked="{Binding UseBrailleAddon}"/>
                        <CheckBox Content="{l:T 'Show playback progress on the braille display (Control+Shift+D)'}" IsChecked="{Binding EnableBrailleProgress}"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T 'Braille display _cells, when the add-on isn\'t running:'}" Target="{Binding ElementName=CellsBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CellsBox" AutomationProperties.Name="{l:T 'Braille display cells, when the add-on isn\'t running'}" ItemsSource="{Binding AvailableBrailleCellCounts}"
                                      SelectedItem="{Binding SelectedBrailleCellCount, Mode=TwoWay}" MinWidth="90"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Library ===== -->
            <TabItem Header="{l:T 'Library'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <CheckBox Content="{l:T 'Keep a watch history on this computer (needed for resume and For You)'}" IsChecked="{Binding RecordHistory}"/>
                        <CheckBox Content="{l:T 'Check my channels for new videos at startup'}" IsChecked="{Binding CheckFeedOnStartup}"/>
                        <CheckBox Content="{l:T 'Hide Shorts in What\'s New, Featured and For You'}" IsChecked="{Binding HideShortsInFeed}"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="{l:T '_Region for Featured and the music charts:'}" Target="{Binding ElementName=RegionBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="RegionBox" AutomationProperties.Name="{l:T 'Region for Featured and the music charts'}" ItemsSource="{Binding RegionChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding FeaturedRegion}" MinWidth="240"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Label"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== SponsorBlock and dislikes ===== -->
            <TabItem Header="{l:T 'SponsorBlock and dislikes'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource NoteText}"
                                   Text="{l:T 'SponsorBlock (sponsor.ajay.app) skips or announces parts of videos that its users marked, such as sponsor reads. Only the first characters of a fingerprint of the video\'s id are sent, so the server can\'t tell which video you watch. In the player, S skips the segment playing now and H jumps to the highlight.'}"/>
                        <CheckBox Content="{l:T 'Use SponsorBlock'}" IsChecked="{Binding SponsorBlockEnabled}"/>
                        <controls:LayoutItemsControl ItemsSource="{Binding SponsorBlockCategories}" Focusable="False"
                                      IsEnabled="{Binding SponsorBlockEnabled}">
                            <controls:LayoutItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource Row}">
                                        <Label Content="{Binding Label}" Target="{Binding ElementName=ActionBox}" Style="{StaticResource SettingLabel}"/>
                                        <ComboBox x:Name="ActionBox" MinWidth="200" AutomationProperties.Name="{Binding SpokenLabel}"
                                                  ItemsSource="{Binding DataContext.SegmentActionChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Action}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </controls:LayoutItemsControl.ItemTemplate>
                        </controls:LayoutItemsControl>
                        <CheckBox Content="{l:T 'Say what was skipped'}" IsChecked="{Binding AnnounceSegmentSkips}" IsEnabled="{Binding SponsorBlockEnabled}"/>
                        <CheckBox Content="{l:T 'Tell me when a video has a highlight'}" IsChecked="{Binding AnnounceHighlight}" IsEnabled="{Binding SponsorBlockEnabled}"/>
                        <CheckBox Content="{l:T 'Tell me when a whole video is labeled, such as sponsored'}" IsChecked="{Binding AnnounceWholeVideoLabels}" IsEnabled="{Binding SponsorBlockEnabled}"/>

                        <TextBlock Text="{l:T 'Dislikes'}" Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Style="{StaticResource NoteText}"
                                   Text="{l:T 'YouTube hides dislike counts. Return YouTube Dislike (returnyoutubedislike.com) estimates them; they appear in the description and when you press I in the player. Only the video\'s id is sent.'}"/>
                        <CheckBox Content="{l:T 'Show likes and estimated dislikes'}" IsChecked="{Binding ShowDislikes}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Updates and help ===== -->
            <TabItem Header="{l:T 'Updates and help'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <CheckBox Content="{l:T 'Check for TimePlayer updates at startup'}" IsChecked="{Binding CheckForAppUpdatesAtStartup}"/>
                        <CheckBox Content="{l:T 'Tell me at startup how many times TimePlayer has run'}" IsChecked="{Binding AnnounceRunCount}"/>
                        <CheckBox Content="{l:T 'Add my runs to the total for everyone (only adds 1 per start, nothing about you)'}" IsChecked="{Binding ShareRunCount}"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{l:T 'Check for TimePlayer _updates'}" Click="CheckAppUpdates_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{l:T 'Update the YouTube _downloader'}" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource SmallButtonStyle}"/>
                            <Button Content="{l:T 'Run dia_gnostics'}" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource SmallButtonStyle}"/>
                            <Button Content="{l:T 'Play _test pattern'}" Click="PlayTestPattern_Click" Style="{StaticResource SmallButtonStyle}"/>
                            <Button Content="{l:T 'Open _log folder'}" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource SmallButtonStyle}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DependencyStatusMessage}" Style="{StaticResource NoteText}"/>
                        <Label Content="{l:T 'Diagnostics _report:'}" Target="{Binding ElementName=ReportBox}" Foreground="#E4E4E7" Padding="0,0,0,4"/>
                        <TextBox x:Name="ReportBox" AutomationProperties.Name="{l:T 'Diagnostics report'}" Text="{Binding DiagnosticsReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="170" FontFamily="Consolas" FontSize="12" Background="#141416"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="{l:T 'Close'}" IsCancel="True" Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Right" MinWidth="100" Margin="0,12,0,0" Click="Close_Click"
                AutomationProperties.AcceleratorKey="Escape"/>
    </Grid>
</Window>
