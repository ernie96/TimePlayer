<Window x:Class="TimePlayer.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="720" Height="660" MinWidth="540" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#1C1C1F"
        Foreground="#F4F4F5">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingLabel" TargetType="Label">
                <Setter Property="Foreground" Value="#E4E4E7"/>
                <Setter Property="Padding" Value="0,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="250"/>
            </Style>
            <Style x:Key="NoteText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#A1A1AA"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource NoteText}">
            <Run Text="{Binding VersionText, Mode=OneWay}" Foreground="#E4E4E7"/>
            <Run Text=". Control+Tab moves between pages. Changes apply right away and are saved when you close this window."/>
        </TextBlock>

        <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                    ItemContainerStyle="{StaticResource StripTabItemStyle}" AutomationProperties.Name="Settings pages">

            <!-- ===== Playback ===== -->
            <TabItem Header="Playback">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <CheckBox x:Name="FirstSetting" Content="Continue videos where I left off" IsChecked="{Binding ResumePlayback}"/>
                        <CheckBox Content="Autoplay a related video when the queue ends (A in the player)" IsChecked="{Binding Autoplay}"/>
                        <CheckBox Content="Use hardware video decoding (takes effect after restart)" IsChecked="{Binding EnableHardwareDecoding}"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="Preferred video _quality:" Target="{Binding ElementName=QualityBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="QualityBox" AutomationProperties.Name="Preferred video quality" ItemsSource="{Binding QualityChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SelectedQuality}" MinWidth="180"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="_Left and Right arrows move:" Target="{Binding ElementName=SmallSeekBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="SmallSeekBox" AutomationProperties.Name="Left and Right arrows move" ItemsSource="{Binding SmallSeekChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SmallSeekSeconds}" MinWidth="180"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="Control+Left and Right m_ove:" Target="{Binding ElementName=LargeSeekBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="LargeSeekBox" AutomationProperties.Name="Control+Left and Right move" ItemsSource="{Binding LargeSeekChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding LargeSeekSeconds}" MinWidth="180"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="Up and Down change the _volume by:" Target="{Binding ElementName=VolumeStepBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="VolumeStepBox" AutomationProperties.Name="Up and Down change the volume by" ItemsSource="{Binding VolumeStepChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding VolumeStepPercent}" MinWidth="180"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Speech and braille ===== -->
            <TabItem Header="Speech and braille">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <CheckBox Content="Read captions aloud as they appear (C in the player)" IsChecked="{Binding SpeakCaptions}"/>
                        <CheckBox Content="Use the NVDA braille add-on (for braille displays; restart NVDA after changing)" IsChecked="{Binding UseBrailleAddon}"/>
                        <CheckBox Content="Show playback progress on the braille display (Control+Shift+D)" IsChecked="{Binding EnableBrailleProgress}"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="Braille display _cells, when the add-on isn't running:" Target="{Binding ElementName=CellsBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CellsBox" AutomationProperties.Name="Braille display cells, when the add-on isn't running" ItemsSource="{Binding AvailableBrailleCellCounts}"
                                      SelectedItem="{Binding SelectedBrailleCellCount, Mode=TwoWay}" MinWidth="90"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Library ===== -->
            <TabItem Header="Library">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <CheckBox Content="Keep a watch history on this computer (needed for resume and For You)" IsChecked="{Binding RecordHistory}"/>
                        <CheckBox Content="Check my channels for new videos at startup" IsChecked="{Binding CheckFeedOnStartup}"/>
                        <CheckBox Content="Hide Shorts in What's New, Featured and For You" IsChecked="{Binding HideShortsInFeed}"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Label Content="_Region for Featured and the music charts:" Target="{Binding ElementName=RegionBox}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="RegionBox" AutomationProperties.Name="Region for Featured and the music charts" ItemsSource="{Binding RegionChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding FeaturedRegion}" MinWidth="240"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Label"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== SponsorBlock and dislikes ===== -->
            <TabItem Header="SponsorBlock and dislikes">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource NoteText}"
                                   Text="SponsorBlock (sponsor.ajay.app) skips or announces parts of videos that its users marked, such as sponsor reads. Only the first characters of a fingerprint of the video's id are sent, so the server can't tell which video you watch. In the player, S skips the segment playing now and H jumps to the highlight."/>
                        <CheckBox Content="Use SponsorBlock" IsChecked="{Binding SponsorBlockEnabled}"/>
                        <ItemsControl ItemsSource="{Binding SponsorBlockCategories}" Focusable="False"
                                      IsEnabled="{Binding SponsorBlockEnabled}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource Row}">
                                        <Label Content="{Binding Label}" Target="{Binding ElementName=ActionBox}" Style="{StaticResource SettingLabel}"/>
                                        <ComboBox x:Name="ActionBox" MinWidth="200" AutomationProperties.Name="{Binding SpokenLabel}"
                                                  ItemsSource="{Binding DataContext.SegmentActionChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Action}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="Say what was skipped" IsChecked="{Binding AnnounceSegmentSkips}" IsEnabled="{Binding SponsorBlockEnabled}"/>
                        <CheckBox Content="Tell me when a video has a highlight" IsChecked="{Binding AnnounceHighlight}" IsEnabled="{Binding SponsorBlockEnabled}"/>
                        <CheckBox Content="Tell me when a whole video is labeled, such as sponsored" IsChecked="{Binding AnnounceWholeVideoLabels}" IsEnabled="{Binding SponsorBlockEnabled}"/>

                        <TextBlock Text="Dislikes" Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Style="{StaticResource NoteText}"
                                   Text="YouTube hides dislike counts. Return YouTube Dislike (returnyoutubedislike.com) estimates them; they appear in the description and when you press I in the player. Only the video's id is sent."/>
                        <CheckBox Content="Show likes and estimated dislikes" IsChecked="{Binding ShowDislikes}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Updates and help ===== -->
            <TabItem Header="Updates and help">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,10,0">
                    <StackPanel>
                        <CheckBox Content="Check for TimePlayer updates at startup" IsChecked="{Binding CheckForAppUpdatesAtStartup}"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Check for TimePlayer _updates" Click="CheckAppUpdates_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Update the YouTube _downloader" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource SmallButtonStyle}"/>
                            <Button Content="Run dia_gnostics" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource SmallButtonStyle}"/>
                            <Button Content="Play _test pattern" Click="PlayTestPattern_Click" Style="{StaticResource SmallButtonStyle}"/>
                            <Button Content="Open _log folder" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource SmallButtonStyle}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DependencyStatusMessage}" Style="{StaticResource NoteText}"/>
                        <Label Content="Diagnostics _report:" Target="{Binding ElementName=ReportBox}" Foreground="#E4E4E7" Padding="0,0,0,4"/>
                        <TextBox x:Name="ReportBox" AutomationProperties.Name="Diagnostics report" Text="{Binding DiagnosticsReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="170" FontFamily="Consolas" FontSize="12" Background="#141416"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Close" IsCancel="True" Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Right" MinWidth="100" Margin="0,12,0,0" Click="Close_Click"
                AutomationProperties.AcceleratorKey="Escape"/>
    </Grid>
</Window>
