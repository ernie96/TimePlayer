<Window x:Class="TimePlayer.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:TimePlayer.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="TimePlayer - Accessible YouTube Player"
        Height="720" Width="1080"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5"
        FocusVisualStyle="{x:Null}">

    <Window.Resources>
        <!-- High-Contrast Focus Visual Style for all focusable controls -->
        <Style x:Key="AccessibleFocusVisualStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3"
                                   Stroke="#38BDF8"
                                   StrokeThickness="2"
                                   StrokeDashArray="2 2"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Button Style -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#52525B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>

        <!-- Base Slider Style with focus rectangle -->
        <Style TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
        </Style>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Search Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Content (Video Area & Results / Queue) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Media Transport Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Status & Screen Reader Announcement Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Search and URL Input Bar -->
        <Border Grid.Row="0" Background="#202023" BorderBrush="#2E2E33" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search YouTube or paste URL"
                         AutomationProperties.HelpText="Enter search keywords or paste a full YouTube video link, then press Enter or activate the Search button."
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        AutomationProperties.Name="Search"
                        AutomationProperties.HelpText="Executes the search for the text entered in the search box."
                        Margin="0,0,8,0"
                        MinWidth="85"/>

                <Button Grid.Column="2"
                        Content="Clear"
                        Command="{Binding ClearSearchCommand}"
                        AutomationProperties.Name="Clear search"
                        AutomationProperties.HelpText="Clears the search input and results."
                        MinWidth="75"/>
            </Grid>
        </Border>

        <!-- Row 1: Main Content Split (Left: Video Host, Right: Results/Queue) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Video Playback Host Area -->
                <ColumnDefinition Width="6*" MinWidth="300"/>
                <ColumnDefinition Width="4" />
                <!-- Right: Search Results & Queue -->
                <ColumnDefinition Width="4*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Video Host Surface Placeholder (will host mpv HwndHost in playback step) -->
            <Border Grid.Column="0"
                    x:Name="VideoHostContainer"
                    Background="#09090B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    Margin="12"
                    Focusable="True"
                    FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                    AutomationProperties.Name="Video player display area"
                    AutomationProperties.HelpText="Displays the video stream when media is loaded. Press Space or K to toggle play/pause, Left/Right arrow to seek.">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="#71717A"
                               TextAlignment="Center"
                               Text="{Binding PlaybackStatusText, StringFormat='TimePlayer Engine ({0})&#x0a;Enter a search or paste a URL to begin.'}"/>
                </Grid>
            </Border>

            <!-- GridSplitter between Video and Results -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="#27272A"
                          AutomationProperties.Name="Resize splitter between video player and search results"/>

            <!-- Right Column: Results & Playlist -->
            <Border Grid.Column="2" Background="#1C1C1F" BorderBrush="#27272A" BorderThickness="1,0,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Search Results &amp; Queue"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#E4E4E7"
                               Margin="0,0,0,8"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <ListBox Grid.Row="1"
                             x:Name="ResultsListBox"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchResult}"
                             Background="#141416"
                             BorderBrush="#27272A"
                             FocusVisualStyle="{StaticResource AccessibleFocusVisualStyle}"
                             AutomationProperties.Name="Search results and queue list"
                             AutomationProperties.HelpText="Use Up and Down arrow keys to review results, Enter to play selection.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6"
                                        BorderBrush="#27272A"
                                        BorderThickness="0,0,0,1"
                                        AutomationProperties.Name="{Binding AccessibleSummary}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="#F4F4F5"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ChannelTitle}"
                                                   FontSize="12"
                                                   Foreground="#A1A1AA"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding AccessibleSummary}"
                                                   FontSize="11"
                                                   Foreground="#71717A"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Media Transport & Playback Control Bar -->
        <Border Grid.Row="2" Background="#202023" BorderBrush="#2E2E33" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Seek Slider Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Button Controls Row -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Seek Progress Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTime, StringFormat='{}{0:mm\\:ss}'}"
                               Foreground="#A1A1AA"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               AutomationProperties.Name="Current playback time"/>

                    <Slider Grid.Column="1"
                            x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Seek slider"
                            AutomationProperties.HelpText="Use Left and Right arrow keys to seek by small steps, Page Up and Page Down for large steps."/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}"
                               Foreground="#A1A1AA"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               AutomationProperties.Name="Total duration"/>
                </Grid>

                <!-- Transport Buttons & Volume / Speed Controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Play/Pause/Seek Buttons -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center: Spacer -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Volume & Speed Controls -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Play / Pause"
                                Command="{Binding TogglePlayPauseCommand}"
                                AutomationProperties.Name="Play or pause"
                                AutomationProperties.HelpText="Toggles playback between play and pause."
                                Margin="0,0,8,0"/>

                        <Button Content="-5s"
                                Command="{Binding SeekSmallBackwardCommand}"
                                AutomationProperties.Name="Seek backward 5 seconds"
                                AutomationProperties.HelpText="Rewinds playback by 5 seconds."
                                Margin="0,0,8,0"/>

                        <Button Content="+5s"
                                Command="{Binding SeekSmallForwardCommand}"
                                AutomationProperties.Name="Seek forward 5 seconds"
                                AutomationProperties.HelpText="Fast forwards playback by 5 seconds."
                                Margin="0,0,8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Volume Controls -->
                        <TextBlock Text="Volume:"
                                   Foreground="#A1A1AA"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Button Content="-"
                                Command="{Binding VolumeDownCommand}"
                                AutomationProperties.Name="Decrease volume by 5 percent"
                                Padding="8,4"
                                Margin="0,0,4,0"/>

                        <TextBlock Text="{Binding VolumePercent, StringFormat='{}{0:0}%'}"
                                   Foreground="#F4F4F5"
                                   VerticalAlignment="Center"
                                   MinWidth="40"
                                   TextAlignment="Center"
                                   Margin="0,0,4,0"
                                   AutomationProperties.Name="Current volume percentage"/>

                        <Button Content="+"
                                Command="{Binding VolumeUpCommand}"
                                AutomationProperties.Name="Increase volume by 5 percent"
                                Padding="8,4"
                                Margin="0,0,16,0"/>

                        <!-- Speed Controls -->
                        <TextBlock Text="Speed:"
                                   Foreground="#A1A1AA"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Button Content="&lt;"
                                Command="{Binding SpeedDownCommand}"
                                AutomationProperties.Name="Decrease playback speed by 0.25x"
                                Padding="8,4"
                                Margin="0,0,4,0"/>

                        <Button Content="{Binding PlaybackSpeed, StringFormat='{}{0:0.##}x'}"
                                Command="{Binding ResetSpeedCommand}"
                                AutomationProperties.Name="Reset speed to 1x"
                                AutomationProperties.HelpText="Resets playback speed back to normal 1x."
                                Padding="8,4"
                                MinWidth="45"
                                Margin="0,0,4,0"/>

                        <Button Content="&gt;"
                                Command="{Binding SpeedUpCommand}"
                                AutomationProperties.Name="Increase playback speed by 0.25x"
                                Padding="8,4"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 3: Status & Screen Reader Live Region Bar -->
        <Border Grid.Row="3" Background="#141416" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- UI Automation Live Region for Screen Readers -->
                <TextBlock x:Name="LiveRegionStatusText"
                           Grid.Column="0"
                           Text="{Binding StatusAnnouncement}"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="Screen reader announcements"/>

                <TextBlock Grid.Column="1"
                           Text="Press F1 for keyboard shortcuts"
                           Foreground="#71717A"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
