<Window x:Class="TimePlayer.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TimePlayer.Wpf.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TimePlayer.Wpf.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1220"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5"
        FocusVisualStyle="{x:Null}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Row container for video lists: spoken summary, focus outline and the actions menu (Applications key). -->
            <Style x:Key="VideoItemStyle" TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu AutomationProperties.Name="{l:T 'Actions'}">
                            <MenuItem Header="{l:T '_Play or open'}" InputGestureText="Enter"
                                      Command="{Binding PlacementTarget.Tag.PlaySearchResultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T 'Add to _queue'}" InputGestureText="Ctrl+Q"
                                      Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Command="{Binding PlacementTarget.Tag.EnqueueSearchResultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T 'Save to or remove from _Watch Later'}" InputGestureText="Ctrl+L"
                                      Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Command="{Binding PlacementTarget.Tag.ToggleWatchLaterForItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T '_Like or unlike'}" InputGestureText="Ctrl+K"
                                      Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Command="{Binding PlacementTarget.Tag.ToggleLikeForItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T 'Add to playlis_t...'}" InputGestureText="Ctrl+P"
                                      Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Command="{Binding PlacementTarget.Tag.ShowAddToPlaylistMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T '_Subscribe or unsubscribe'}" InputGestureText="Ctrl+S"
                                      Command="{Binding PlacementTarget.Tag.ToggleSubscriptionForItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T 'Go to _channel'}" InputGestureText="Ctrl+G"
                                      Command="{Binding PlacementTarget.Tag.OpenChannelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T 'Cop_y share link'}" InputGestureText="Ctrl+C"
                                      Command="{Binding PlacementTarget.Tag.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T '_Download audio'}" InputGestureText="Ctrl+D"
                                      Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Command="{Binding PlacementTarget.Tag.DownloadAudioForItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T 'Download _video'}" InputGestureText="Ctrl+D"
                                      Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Command="{Binding PlacementTarget.Tag.DownloadVideoForItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T '_Remove from this list'}" InputGestureText="Delete"
                                      Visibility="{Binding PlacementTarget.Tag.CanRemoveFromSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Command="{Binding PlacementTarget.Tag.RemoveSelectedItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T '_Not interested'}" InputGestureText="Delete"
                                      Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Command="{Binding PlacementTarget.Tag.NotInterestedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T 'Don\'t recommend this c_hannel'}" InputGestureText="Shift+Delete"
                                      Command="{Binding PlacementTarget.Tag.DontRecommendChannelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleLabel}"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu AutomationProperties.Name="{l:T 'Queue actions'}">
                            <MenuItem Header="{l:T '_Play now'}" InputGestureText="Enter"
                                      Command="{Binding PlacementTarget.Tag.PlayQueueItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T '_Remove from queue'}" InputGestureText="Delete"
                                      Command="{Binding PlacementTarget.Tag.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T '_Clear the whole queue'}"
                                      Command="{Binding PlacementTarget.Tag.ClearQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Comments are a tree: Right expands a comment's replies, Left goes back to the comment. -->
            <Style x:Key="CommentTreeItemStyle" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                <Setter Property="Foreground" Value="#F4F4F5"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu AutomationProperties.Name="{l:T 'Comment actions'}">
                            <MenuItem Header="{l:T 'Show or hide _replies'}" InputGestureText="Right, Left or Enter"
                                      Command="{Binding PlacementTarget.Tag.ToggleRepliesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{l:T '_Copy comment'}" InputGestureText="Ctrl+C"
                                      Command="{Binding PlacementTarget.Tag.CopyCommentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>

            <HierarchicalDataTemplate x:Key="CommentNodeTemplate" ItemsSource="{Binding Replies}">
                <Border Padding="8,6" BorderBrush="#27272A" BorderThickness="0,0,0,1" MaxWidth="360">
                    <StackPanel>
                        <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8"
                                   Visibility="{Binding IsComment, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#F4F4F5" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#A1A1AA"
                                   Visibility="{Binding Details, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Top bar: search (slash, Control+F or F6 from anywhere) ============ -->
        <Border x:Name="TopBar" Grid.Row="0" Background="#202023" BorderBrush="#2E2E33" BorderThickness="0,0,0,1" Padding="16,10"
                KeyboardNavigation.TabNavigation="Cycle"
                Visibility="{Binding IsLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ModeName, StringFormat=TimePlayer {0}}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"
                           VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.HeadingLevel="Level1"/>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T 'Search YouTube or paste a link'}"
                         AutomationProperties.AcceleratorKey="Slash"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox x:Name="SearchKindBox" Grid.Column="2" ItemsSource="{Binding SearchKinds}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedSearchKind, Mode=TwoWay}" MinWidth="110" Margin="0,0,8,0"
                          AutomationProperties.Name="{l:T 'Search for'}"/>

                <Button Grid.Column="3" Content="{l:T 'Settings (F2)'}" Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="{l:T 'Settings'}" AutomationProperties.AcceleratorKey="F2"/>
            </Grid>
        </Border>

        <!-- ============ Error banner ============ -->
        <Border x:Name="ErrorBanner" Grid.Row="1" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="0,0,0,1" Padding="16,8"
                KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.Name="{Binding ErrorBannerName}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- A read-only text box, not a label, so Tab and the arrow keys can read the reason. -->
                <TextBox x:Name="ErrorMessageBox" Grid.Column="0" Text="{Binding ErrorMessage, Mode=OneWay}" IsReadOnly="True"
                         Foreground="#FEE2E2" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.Name="{l:T 'Problem'}"/>
                <Button Grid.Column="1" Content="{l:T '_Retry'}" Command="{Binding RetryLastActionCommand}" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="{l:T 'Retry'}" AutomationProperties.HelpText="{Binding ErrorMessage}" Padding="12,4" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Content="{l:T '_Dismiss'}" Command="{Binding ClearErrorCommand}"
                        AutomationProperties.Name="{l:T 'Dismiss'}" AutomationProperties.HelpText="{Binding ErrorMessage}" Padding="10,4" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ============ Workspace ============ -->
        <Grid Grid.Row="2">

            <!-- ===== Library view ===== -->
            <Grid x:Name="LibraryArea" Visibility="{Binding IsLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="16,12"
                  KeyboardNavigation.TabNavigation="Cycle">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TabControl x:Name="SectionTabControl"
                            Grid.Row="0"
                            ItemsSource="{Binding SectionTabs}"
                            SelectedItem="{Binding SelectedSectionTab, Mode=TwoWay}"
                            ItemContainerStyle="{StaticResource SectionTabItemStyle}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            AutomationProperties.Name="{l:T 'Sections'}">
                    <TabControl.ContentTemplate>
                        <DataTemplate/>
                    </TabControl.ContentTemplate>
                </TabControl>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="{Binding SectionTitle}" FontSize="17" FontWeight="Bold" Foreground="#E4E4E7"
                               TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="{Binding SectionCountText}" FontSize="14" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="{l:T 'Loading...'}" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSectionLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoadingMore}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Section toolbar: only the buttons that apply to this section are shown -->
                <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                    <Button Content="{l:T '&lt; _Back'}" Command="{Binding GoBackCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsDetailView, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Back'}" AutomationProperties.AcceleratorKey="Alt+Left"/>

                    <Button Content="{l:T 'Play _all'}" Command="{Binding PlayAllCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding CanPlayAll, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Play all'}"/>
                    <Button Content="{l:T 'Sh_uffle'}" Command="{Binding ShufflePlayCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding CanPlayAll, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Shuffle play'}"/>
                    <Button Content="{l:T '_Save to Playlists'}" Command="{Binding SaveOpenPlaylistCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding CanSaveOpenPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Save to Playlists'}"/>
                    <Button Content="{l:T 'Copy _link'}" Command="{Binding CopyOpenPlaylistLinkCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsPlaylistView, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Copy playlist link'}"/>
                    <Button Content="{l:T '_New playlist...'}" Command="{Binding CreatePlaylistCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsPlaylistsSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'New playlist'}"/>
                    <Button Content="{l:T '_Rename...'}" Command="{Binding RenameOpenPlaylistCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding CanEditPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Rename playlist'}"/>
                    <Button Content="{l:T '_Delete playlist...'}" Command="{Binding DeleteOpenPlaylistCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding CanEditPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Delete playlist'}"/>
                    <Button Content="{l:T '_Import from Google Takeout...'}" Click="ImportTakeout_Click" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsPlaylistsSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Import from Google Takeout'}"/>
                    <Button Content="{l:T '_How to get my YouTube data...'}" Click="YouTubeSubscriptionsHelp_Click" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsPlaylistsSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'How to get my YouTube data'}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                Visibility="{Binding IsFeaturedSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Label Content="{l:T '_Category:'}" Target="{Binding ElementName=FeaturedCategoryBox}" Foreground="#E4E4E7" VerticalAlignment="Center" Padding="0,0,6,0"/>
                        <ComboBox x:Name="FeaturedCategoryBox" ItemsSource="{Binding FeaturedCategories}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding SelectedFeaturedCategory, Mode=TwoWay}" MinWidth="120"
                                  AutomationProperties.Name="{l:T 'Category'}"/>
                    </StackPanel>
                    <Button Content="{l:T '_Import subscriptions...'}" Click="ImportSubscriptions_Click" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsChannelsSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Import subscriptions'}"/>
                    <Button Content="{l:T '_How to get my YouTube subscriptions...'}" Click="YouTubeSubscriptionsHelp_Click" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsChannelsSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'How to get my YouTube subscriptions'}"/>
                    <Button Content="{l:T 'E_xport subscriptions...'}" Click="ExportSubscriptions_Click" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsChannelsSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Export subscriptions'}"/>
                    <Button Content="{l:T '_Clear history...'}" Click="ClearHistory_Click" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsHistorySection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Clear history'}"/>
                    <Button Content="{l:T '_Clear queue'}" Command="{Binding ClearQueueCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsQueueSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{l:T 'Clear queue'}"/>
                    <Button Content="{l:T 'Refresh (F5)'}" Command="{Binding RefreshSectionCommand}" Style="{StaticResource SmallButtonStyle}"
                            Visibility="{Binding IsQueueSection, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"
                            AutomationProperties.Name="{l:T 'Refresh'}" AutomationProperties.AcceleratorKey="F5"/>
                </WrapPanel>

                <!-- Empty-section explanation -->
                <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="#A1A1AA"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24" Text="{Binding SectionEmptyText}"
                           Visibility="{Binding IsSectionEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- The list for every section except Queue -->
                <ListBox x:Name="ResultsListBox"
                         Grid.Row="3"
                         Style="{StaticResource AccessibleListBoxStyle}"
                         ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedSearchResult}"
                         ItemContainerStyle="{StaticResource VideoItemStyle}"
                         ItemTemplate="{StaticResource VideoRowTemplate}"
                         AutomationProperties.Name="{Binding SectionTitle}"
                         Visibility="{Binding IsResultsListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding PlaySearchResultCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding EnqueueSearchResultCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleWatchLaterForItemCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ToggleSubscriptionForItemCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="G" Modifiers="Control" Command="{Binding OpenChannelCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyLinkCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedItemCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DontRecommendChannelCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ToggleLikeForItemCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ShowAddToPlaylistMenuCommand}" CommandParameter="{Binding SelectedSearchResult}"/>
                    </ListBox.InputBindings>
                </ListBox>

                <!-- Queue section -->
                <ListBox x:Name="QueueListBox"
                         Grid.Row="3"
                         Style="{StaticResource AccessibleListBoxStyle}"
                         ItemsSource="{Binding PlaybackQueue}"
                         SelectedItem="{Binding SelectedQueueItem}"
                         ItemContainerStyle="{StaticResource QueueItemStyle}"
                         ItemTemplate="{StaticResource QueueRowTemplate}"
                         AutomationProperties.Name="{l:T 'Queue'}"
                         Visibility="{Binding IsQueueListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding PlayQueueItemCommand}" CommandParameter="{Binding SelectedQueueItem}"/>
                        <KeyBinding Key="Delete" Command="{Binding RemoveQueueItemCommand}" CommandParameter="{Binding SelectedQueueItem}"/>
                    </ListBox.InputBindings>
                </ListBox>
            </Grid>

            <!-- ===== Player view ===== -->
            <Grid x:Name="PlayerView" Visibility="{Binding IsPlayerViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#101012">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: back, title, channel actions -->
                <Border Grid.Row="0" Background="#1C1C1F" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackToSearchButton" Grid.Column="0" Content="{l:T '&lt; Back (Esc)'}" Click="BackFromPlayer_Click"
                                AutomationProperties.Name="{l:T 'Back to the list'}" AutomationProperties.AcceleratorKey="Escape" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentVideoTitle}" FontSize="17" FontWeight="Bold" Foreground="#F4F4F5"
                                       TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1"/>
                            <TextBlock Text="{Binding CurrentChannelTitle}" FontSize="13" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="PlayerActionsButton" Grid.Column="2" Content="{l:T '_Actions...'}" Click="PlayerActions_Click"
                                Style="{StaticResource SmallButtonStyle}" VerticalAlignment="Center"
                                AutomationProperties.Name="{l:T 'Actions'}" AutomationProperties.AcceleratorKey="Alt+A, Applications"
                                AutomationProperties.HelpText="{l:T 'Like, subscribe, Watch Later, playlist, share, download, captions, speed, sound and more'}"/>
                    </Grid>
                </Border>

                <!-- Video on the left, Up next / Comments / Description / Queue on the right -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="*"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MusicMode}" Value="True">
                                            <Setter Property="Width" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="420"/>
                                    <Setter Property="MinWidth" Value="280"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MusicMode}" Value="True">
                                            <Setter Property="Width" Value="*"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="VideoHostContainer" Grid.Row="0" Background="#000000">
                            <Grid>
                                <controls:MpvVideoHost x:Name="MpvHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#A1A1AA"
                                           TextAlignment="Center" IsHitTestVisible="False" Text="{Binding PlaybackStatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVideoActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <!-- Captions line (shown on screen; read aloud only when "Read captions" is on) -->
                        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="16,8" MinHeight="40"
                                Visibility="{Binding CurrentSubtitleText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                            <TextBlock x:Name="LiveSubtitleRegion" Text="{Binding CurrentSubtitleText}" Foreground="#FDE047" FontSize="16"
                                       FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#27272A" Focusable="False" IsTabStop="False"/>

                    <TabControl x:Name="PlayerPanelTabs" Grid.Column="2" Background="#1C1C1F" BorderThickness="0" Padding="8"
                                SelectedIndex="{Binding SelectedPlayerPanelIndex, Mode=TwoWay}"
                                AutomationProperties.Name="{l:T 'Video panels'}">
                        <TabItem Header="{l:T '_Up next'}" Style="{StaticResource StripTabItemStyle}" AutomationProperties.Name="{l:T 'Up next'}" AutomationProperties.AcceleratorKey="Alt+U">
                            <Grid>
                                <TextBlock Text="{l:T 'Related videos appear here once the video starts.'}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="8"
                                           Visibility="{Binding UpNext.Count, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>
                                <ListBox x:Name="UpNextListBox"
                                         Style="{StaticResource AccessibleListBoxStyle}"
                                         ItemsSource="{Binding UpNext}"
                                         SelectedItem="{Binding SelectedUpNext}"
                                         ItemContainerStyle="{StaticResource VideoItemStyle}"
                                         ItemTemplate="{StaticResource VideoRowTemplate}"
                                         AutomationProperties.Name="{l:T 'Up next'}">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding PlaySearchResultCommand}" CommandParameter="{Binding SelectedUpNext}"/>
                                        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding EnqueueSearchResultCommand}" CommandParameter="{Binding SelectedUpNext}"/>
                                        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleWatchLaterForItemCommand}" CommandParameter="{Binding SelectedUpNext}"/>
                                        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ToggleSubscriptionForItemCommand}" CommandParameter="{Binding SelectedUpNext}"/>
                                        <KeyBinding Key="G" Modifiers="Control" Command="{Binding OpenChannelCommand}" CommandParameter="{Binding SelectedUpNext}"/>
                                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyLinkCommand}" CommandParameter="{Binding SelectedUpNext}"/>
                                        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ToggleLikeForItemCommand}" CommandParameter="{Binding SelectedUpNext}"/>
                                        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ShowAddToPlaylistMenuCommand}" CommandParameter="{Binding SelectedUpNext}"/>
                                    </ListBox.InputBindings>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{l:T '_Comments'}" Style="{StaticResource StripTabItemStyle}" AutomationProperties.Name="{l:T 'Comments'}" AutomationProperties.AcceleratorKey="Alt+C">
                            <Grid>
                                <TextBlock Text="{Binding CommentsStatus}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="8"
                                           Visibility="{Binding CommentsStatus, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
<TreeView x:Name="CommentsTree"
                                          ItemsSource="{Binding Comments}"
                                          ItemContainerStyle="{StaticResource CommentTreeItemStyle}"
                                          ItemTemplate="{StaticResource CommentNodeTemplate}"
                                          Background="#141416" BorderBrush="#27272A" Foreground="#F4F4F5"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          SelectedItemChanged="CommentsTree_SelectedItemChanged"
                                          AutomationProperties.Name="{l:T 'Comments'}"
                                          Visibility="{Binding Comments.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TreeView.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ToggleRepliesCommand}" CommandParameter="{Binding SelectedComment}"/>
                                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommentCommand}" CommandParameter="{Binding SelectedComment}"/>
                                    </TreeView.InputBindings>
                                </TreeView>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{l:T '_Description'}" Style="{StaticResource StripTabItemStyle}" AutomationProperties.Name="{l:T 'Description'}" AutomationProperties.AcceleratorKey="Alt+D">
                            <TextBox x:Name="DescriptionBox" Text="{Binding VideoDescriptionText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#141416" BorderBrush="#27272A" FontSize="14"
                                     AutomationProperties.Name="{l:T 'Description'}"/>
                        </TabItem>
                        <TabItem Header="{l:T '_Queue'}" Style="{StaticResource StripTabItemStyle}" AutomationProperties.Name="{l:T 'Queue'}" AutomationProperties.AcceleratorKey="Alt+Q">
                            <Grid>
                                <TextBlock Text="{l:T 'The queue is empty. Control+Q on any video adds it.'}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="8"
                                           Visibility="{Binding PlaybackQueue.Count, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>
                                <ListBox x:Name="PlayerQueueListBox"
                                         Style="{StaticResource AccessibleListBoxStyle}"
                                         ItemsSource="{Binding PlaybackQueue}"
                                         SelectedItem="{Binding SelectedQueueItem}"
                                         ItemContainerStyle="{StaticResource QueueItemStyle}"
                                         ItemTemplate="{StaticResource QueueRowTemplate}"
                                         AutomationProperties.Name="{l:T 'Queue'}">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding PlayQueueItemCommand}" CommandParameter="{Binding SelectedQueueItem}"/>
                                        <KeyBinding Key="Delete" Command="{Binding RemoveQueueItemCommand}" CommandParameter="{Binding SelectedQueueItem}"/>
                                    </ListBox.InputBindings>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Transport -->
                <Border Grid.Row="2" Background="#1C1C1F" BorderBrush="#2E2E33" BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" Foreground="#A1A1AA" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0"
                                    Maximum="{Binding DurationSeconds}"
                                    Value="{Binding SliderSeconds, Mode=TwoWay}"
                                    SmallChange="{Binding SmallSeekSeconds}" LargeChange="{Binding LargeSeekSeconds}" IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:T 'Position'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#A1A1AA" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- On-screen copy of the braille progress line (clicking it seeks). Not a tab stop. -->
                        <TextBox x:Name="BrailleProgressTextBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" Focusable="False" IsTabStop="False"
                                 FontFamily="Consolas, Segoe UI Symbol" FontSize="16" Background="#141416" Foreground="#38BDF8" BorderBrush="#27272A"
                                 Padding="6,3" Margin="0,0,0,8" AutomationProperties.Name="{l:T 'Braille progress'}"
                                 Visibility="{Binding EnableBrailleProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 PreviewMouseDown="BrailleProgressTextBox_PreviewMouseDown"/>

                        <WrapPanel>
                            <Button x:Name="PlayPauseButton" Content="{Binding PlayPauseButtonText}" Command="{Binding TogglePlayPauseCommand}"
                                    Style="{StaticResource AccentButtonStyle}" MinWidth="90" Margin="0,0,6,0"
                                    AutomationProperties.Name="{Binding PlayPauseButtonText}" AutomationProperties.AcceleratorKey="K"/>
                            <Button Content="{l:T 'Previous'}" Command="{Binding PlayPreviousCommand}" IsEnabled="{Binding CanPlayPrevious}" Style="{StaticResource SmallButtonStyle}"
                                    AutomationProperties.Name="{l:T 'Previous'}" AutomationProperties.AcceleratorKey="Shift+P"/>
                            <Button Content="{l:T 'Next'}" Command="{Binding PlayNextOrUpNextCommand}" Style="{StaticResource SmallButtonStyle}" Margin="0,0,16,0"
                                    AutomationProperties.Name="{l:T 'Next'}" AutomationProperties.AcceleratorKey="Shift+N"/>
                            <Button Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource SmallButtonStyle}"
                                    AutomationProperties.Name="{Binding MuteButtonText}" AutomationProperties.AcceleratorKey="M"/>
                            <TextBlock Text="{Binding VolumeText}" Foreground="#F4F4F5" VerticalAlignment="Center" Margin="6,0,16,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Now playing (music plays on while you browse) ============ -->
        <Border x:Name="NowPlayingBar" Grid.Row="3" Background="#1C1C1F" BorderBrush="#2E2E33" BorderThickness="0,1,0,0" Padding="16,8"
                KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{l:T 'Now playing'}"
                Visibility="{Binding IsNowPlayingBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NowPlayingText}" Foreground="#F4F4F5" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="#A1A1AA" FontSize="12">
                        <Run Text="{Binding CurrentTimeText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NowPlayingPlayPause" Content="{Binding PlayPauseButtonText}" Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource AccentButtonStyle}"
                            MinWidth="80" Margin="0,0,6,0" AutomationProperties.Name="{Binding PlayPauseButtonText}" AutomationProperties.AcceleratorKey="Control+Space"/>
                    <Button Content="{l:T 'Previous'}" Command="{Binding PlayPreviousCommand}" IsEnabled="{Binding CanPlayPrevious}" Style="{StaticResource SmallButtonStyle}"
                            AutomationProperties.Name="{l:T 'Previous'}" AutomationProperties.AcceleratorKey="Control+Shift+P"/>
                    <Button Content="{l:T 'Next'}" Command="{Binding PlayNextOrUpNextCommand}" Style="{StaticResource SmallButtonStyle}"
                            AutomationProperties.Name="{l:T 'Next'}" AutomationProperties.AcceleratorKey="Control+Shift+N"/>
                    <Button Content="{l:T 'Open player'}" Command="{Binding ShowPlayerViewCommand}" Style="{StaticResource SmallButtonStyle}"
                            AutomationProperties.Name="{l:T 'Open player'}" AutomationProperties.AcceleratorKey="Alt+P"/>
                    <Button Content="{l:T 'Stop'}" Command="{Binding StopPlaybackSessionCommand}" Style="{StaticResource SmallButtonStyle}"
                            AutomationProperties.Name="{l:T 'Stop'}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="4" Background="#141416" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Screen reader announcements are raised from here (live region) -->
                <TextBlock x:Name="LiveRegionStatusText" Grid.Column="0" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DownloadStatusText}" Foreground="#38BDF8" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="{l:T 'F1: keys for where you are   F6: next area   /: search'}" Foreground="#8E8E96" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
