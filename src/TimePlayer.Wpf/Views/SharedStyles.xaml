<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:TimePlayer.Wpf.Converters">

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:BooleanToVisibilityInvertedConverter x:Key="BooleanToVisibilityInvertedConverter"/>
    <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
    <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

    <!-- Palette -->
    <SolidColorBrush x:Key="WindowBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1C1C1F"/>
    <SolidColorBrush x:Key="BarBrush" Color="#202023"/>
    <SolidColorBrush x:Key="ListBrush" Color="#141416"/>
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#27272A"/>
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#3F3F46"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="#8E8E96"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentFillBrush" Color="#0369A1"/>

    <!-- High-contrast focus outline for every focusable control -->
    <Style x:Key="AccessibleFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="#38BDF8" StrokeThickness="2" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
        <Setter Property="Background" Value="#27272A"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#3F3F46"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#38BDF8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#52525B"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#0284C7"/>
        <Setter Property="BorderBrush" Value="#38BDF8"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
        <Setter Property="Background" Value="#27272A"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style x:Key="HeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>

    <!-- Tabs: a plain header strip; the panel below shows the content -->
    <Style x:Key="StripTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="#D4D4D8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="#202023" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="12,6" Margin="0,0,6,6">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#0369A1"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource StripTabItemStyle}">
        <Setter Property="Header" Value="{Binding Header}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Header}"/>
        <Setter Property="AutomationProperties.AcceleratorKey" Value="{Binding Shortcut}"/>
    </Style>

    <Style x:Key="AccessibleListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource ListBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisualStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <!-- One row per video (results, Up next): status badge, title, then details in muted text -->
    <DataTemplate x:Key="VideoRowTemplate">
        <Border Padding="10,8" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#0369A1" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding StatusPrefix, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusPrefix}" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="#F4F4F5" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Margin="0,3,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ChannelTitle}" FontSize="13" Foreground="#38BDF8" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Duration, StringFormat='{}{0:g}'}" FontSize="12" Foreground="#A1A1AA" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ViewCountText}" FontSize="12" Foreground="#A1A1AA" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding UploadDateText}" FontSize="12" Foreground="#A1A1AA"/>
                </WrapPanel>
                <TextBlock Text="Channel - press Enter to see its videos" FontSize="12" Foreground="#A1A1AA" Margin="0,3,0,0"
                           Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="QueueRowTemplate">
        <Border Padding="10,6" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="#F4F4F5" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ChannelTitle}" FontSize="12" Foreground="#A1A1AA"/>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
